PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use verified TLS for hosted PostgreSQL. Set false only for local development.
DATABASE_SSL=true
# Set false only for temporary testing with an unverified server certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional path to provider CA certificate, if required.
DATABASE_CA_FILE=
# Generate two separate random secrets, each at least 32 characters.
TOKEN_SECRET=
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SupportDesk <support@yourdomain.com>
# Set only to the verified number of reverse proxies used by your host.
TRUST_PROXY_HOPS=0
